rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profil: boleh dibaca pengguna login (untuk mencari teman via kode/username);
    // hanya pemilik yang boleh menulis.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;

      // Daftar teman milik {uid}
      match /friends/{fid} {
        allow read: if request.auth != null && request.auth.uid == uid;

        // Pemilik daftar bebas mengelola daftarnya sendiri.
        allow write: if request.auth != null && request.auth.uid == uid;

        // Pihak lain (fid) hanya boleh:
        //  - membuat undangan masuk "pending_in" bila belum ada entri;
        //  - menerima undangan: pending_out -> accepted (bukti pemilik yang mengundang);
        //  - menghapus pertemanan.
        allow create: if request.auth != null && request.auth.uid == fid
          && request.resource.data.status == 'pending_in';
        allow update: if request.auth != null && request.auth.uid == fid
          && resource.data.status == 'pending_out'
          && request.resource.data.status == 'accepted';
        allow delete: if request.auth != null && request.auth.uid == fid;
      }
    }

    // Lokasi: pemilik menulis; hanya teman yang disetujui yang boleh membaca.
    match /locations/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || get(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid)).data.status == 'accepted'
      );
    }
  }
}
