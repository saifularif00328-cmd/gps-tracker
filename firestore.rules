rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profil: boleh dibaca pengguna login (untuk mencari teman via kode/username);
    // hanya pemilik yang boleh menulis.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;

      // Daftar teman milik {uid}
      match /friends/{fid} {
        allow read: if request.auth != null && request.auth.uid == uid;

        // Pemilik daftar bebas mengelola daftarnya sendiri.
        allow write: if request.auth != null && request.auth.uid == uid;

        // Pihak lain (fid) hanya boleh:
        //  - membuat undangan masuk "pending_in" bila belum ada entri;
        //  - menerima undangan: pending_out -> accepted (bukti pemilik yang mengundang);
        //  - menghapus pertemanan.
        allow create: if request.auth != null && request.auth.uid == fid
          && request.resource.data.status == 'pending_in';
        allow update: if request.auth != null && request.auth.uid == fid
          && resource.data.status == 'pending_out'
          && request.resource.data.status == 'accepted';
        allow delete: if request.auth != null && request.auth.uid == fid;
      }

      // Tempat milik sendiri (Rumah, Kantor, dst): hanya pemilik.
      match /places/{pid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Riwayat perjalanan: ditulis pemilik, dibaca pemilik + teman yang disetujui.
      match /trips/{tid} {
        allow write: if request.auth != null && request.auth.uid == uid;
        allow read: if request.auth != null && (
          request.auth.uid == uid
          || get(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid)).data.status == 'accepted'
        );
      }

      // Peristiwa (tiba/pergi/baterai rendah): ditulis pemilik, dibaca pemilik + teman yang disetujui.
      match /events/{eid} {
        allow write: if request.auth != null && request.auth.uid == uid;
        allow read: if request.auth != null && (
          request.auth.uid == uid
          || get(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid)).data.status == 'accepted'
        );
      }
    }

    // Chat: peserta = dua uid pada chatId ("uidA_uidB"), keduanya harus saling berstatus accepted.
    match /chats/{chatId}/messages/{mid} {
      function ids() { return chatId.split('_'); }
      function peer() { return ids()[0] == request.auth.uid ? ids()[1] : ids()[0]; }
      function member() {
        return request.auth != null
          && ids().size() == 2
          && request.auth.uid in ids()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(peer())).data.status == 'accepted'
          && get(/databases/$(database)/documents/users/$(peer())/friends/$(request.auth.uid)).data.status == 'accepted';
      }
      allow read: if member();
      allow create: if member()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.type in ['text', 'voice', 'ping']
        && request.resource.data.ts is number
        && (!('text' in request.resource.data) || request.resource.data.text.size() <= 1000)
        && (!('audio' in request.resource.data) || request.resource.data.audio.size() <= 700000);
      allow update: if false;
      allow delete: if member() && resource.data.from == request.auth.uid;
    }

    // Lokasi: pemilik menulis; hanya teman yang disetujui yang boleh membaca.
    match /locations/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || get(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid)).data.status == 'accepted'
      );
    }
  }
}
